# ============================================
# BatStateU Key Borrowing System Configuration
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_NAME="BatStateU Key Borrowing Platform"
APP_VERSION=1.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/key_borrowing_system

# JWT Configuration
JWT_SECRET=BSU-KBS-9f2d84c1b5e3a0f76d2e418c92a5b6d1
JWT_EXPIRE=7d

# Admin Default Credentials
ADMIN_USERNAME=CPETadmin
ADMIN_PASSWORD=admin123!
ADMIN_EMAIL=admin@batstateu.edu.ph
ADMIN_FULL_NAME="System Administrator"
ADMIN_VERIFICATION_CODE=CPETBSU

# QR Code Configuration
QR_CODE_EXPIRY_DAYS=7
# How long (in seconds) a QR shows as "Used" after a successful scan (admin chart/status).
QR_USED_STATUS_WINDOW_SECONDS=30

# Security Settings
SESSION_SECRET=batstateu_session_secret_2025_change_this_in_production
CORS_ORIGIN=http://localhost:5500

# ============================================
# Password Reset (Teacher Login Only)
# ============================================
# Used by /api/auth/password-reset/request to email a one-time reset link.
# NOTE: For Gmail you must use an App Password (not your normal password).
APP_BASE_URL=https://localhost:3443
RESET_TOKEN_EXPIRE_MINUTES=15
SMTP_SERVICE=gmail
SMTP_USER=keybsu25@gmail.com
SMTP_PASS=xsok rfgk rbgt llxa
MAIL_FROM="BatStateU Key System <your-email@gmail.com>"

# ============================================
# Local HTTPS for phone camera scanning
# ============================================
# Live camera scanning on phones usually needs HTTPS.
# To enable it, provide either a PFX file or both a cert and key.
HTTPS_ENABLED=true
HTTPS_PORT=3443
HTTPS_PFX_FILE=public/downloads/local-https-cert.pfx
HTTPS_PFX_PASSWORD=SreEOL3YfdVKaw74vh9mykqx
# HTTPS_CERT_FILE=
# HTTPS_KEY_FILE=

# If true, password reset will show "email not found" for unknown emails (less secure).
REVEAL_PASSWORD_RESET_USER_EXISTS=true

# ============================================
# reCAPTCHA (v2 checkbox)
# ============================================
# Disabled because the login/create pages do not render a reCAPTCHA widget.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=6Lc0OWMsAAAAAEgYX1ZyG7UnDuQU-kMa1E9bobON
RECAPTCHA_SECRET_KEY=6Lc0OWMsAAAAAMb7nBchvbkEIsa4EnFvrf30SUfm

# ============================================
# ESP32 Locker Controller
# ============================================
# Default SoftAP IP for the ESP32 firmware from "main .c"
LOCKER_CONTROLLER_BASE_URL=http://192.168.4.1
LOCKER_CONTROLLER_STATUS_PATH=/status
LOCKER_CONTROLLER_UNLOCK_PATH=/unlock
LOCKER_CONTROLLER_TIMEOUT_MS=3000
LOCKER_CONTROLLER_UNLOCK_ATTEMPTS=2
LOCKER_CONTROLLER_STATUS_ATTEMPTS=1
LOCKER_CONTROLLER_RETRY_DELAY_MS=200
LOCKER_CONTROLLER_MAX_LOCKS=32
LOCKER_CONTROLLER_SERIAL_ENABLED=true
LOCKER_CONTROLLER_SERIAL_PORT=COM3
LOCKER_CONTROLLER_SERIAL_TIMEOUT_MS=4500
LOCKER_CONTROLLER_AUTO_UNLOCK=true
LOCKER_CONTROLLER_REQUIRED=true
LOCKER_CONTROLLER_TRIGGER_ON=all
# Optional: make the ESP join your house/router WiFi while keeping the LockerSystem hotspot fallback.
# These are sent to the ESP over USB serial by start-local-system.ps1 and saved in the ESP's NVS memory.
# Set these once, then the ESP will auto-connect on future boots.
ESP_STA_SSID=Dean's Extension
ESP_STA_PASSWORD=9876543210
# Phone access mode:
# - pure_fast: direct router/LAN access only for best speed
# - hybrid: keep Cloudflare available as fallback
PHONE_ACCESS_MODE=pure_fast
# Optional comma-separated fallbacks if the primary base URL changes
# LOCKER_CONTROLLER_BASE_URLS=http://192.168.4.1,http://192.168.137.1

LOCKER_CONTROLLER_SERIAL_AUTO_DETECT=true

LOCKER_CONTROLLER_SERIAL_PORTS=COM4,COM3
