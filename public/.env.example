# Application
NODE_ENV=development
APP_NAME=BatStateU Key Borrowing Platform
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:3000
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/key_borrowing_system

# Security
JWT_SECRET=change-this-to-a-long-random-secret
SESSION_SECRET=change-this-too
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=600
RATE_LIMIT_AUTH_WINDOW_MS=600000
RATE_LIMIT_AUTH_MAX=40

# Default admin bootstrap
ADMIN_USERNAME=CPETadmin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator

# Email and password reset
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BatStateU Key System <no-reply@example.com>
SUPPORT_EMAIL=
RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=30
EMAIL_VERIFICATION_MAX_ATTEMPTS=6

# reCAPTCHA
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERIFY_TIMEOUT_MS=7000

# Local HTTPS scanner support
HTTPS_ENABLED=false
HTTPS_PORT=3443
HTTPS_PFX_FILE=
HTTPS_PFX_PASSWORD=
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# ESP32 locker controller
LOCKER_CONTROLLER_ENABLED=true
LOCKER_CONTROLLER_REQUIRED=true
LOCKER_CONTROLLER_BASE_URL=http://192.168.4.1
LOCKER_CONTROLLER_BASE_URLS=
LOCKER_CONTROLLER_STATUS_PATH=/status
LOCKER_CONTROLLER_UNLOCK_PATH=/unlock
LOCKER_CONTROLLER_TIMEOUT_MS=3000
LOCKER_CONTROLLER_STATUS_ATTEMPTS=1
LOCKER_CONTROLLER_UNLOCK_ATTEMPTS=2
LOCKER_CONTROLLER_MAX_LOCKS=32
LOCKER_CONTROLLER_TRIGGER_ON=all
LOCKER_CONTROLLER_SSID_HINT=LockerSystem
LOCKER_CONTROLLER_IP_HINT=192.168.4.1

# ESP32 USB serial fallback
LOCKER_CONTROLLER_SERIAL_ENABLED=true
LOCKER_CONTROLLER_SERIAL_AUTO_DETECT=true
LOCKER_CONTROLLER_SERIAL_PORT=COM3
LOCKER_CONTROLLER_SERIAL_PORTS=
LOCKER_CONTROLLER_SERIAL_TIMEOUT_MS=4500

# ESP automatic provisioning after flashing
# Leave ESP_STA_SSID blank to use ESP hotspot-only mode.
ESP_STA_SSID=
ESP_STA_PASSWORD=
PHONE_ACCESS_MODE=hybrid

# UI and upload limits
QR_USED_STATUS_WINDOW_SECONDS=30
MAX_PROFILE_PHOTO_BYTES=250000
REVEAL_PASSWORD_RESET_USER_EXISTS=false

